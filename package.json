{
  "name": "flux-math-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pdf:build": "python tools/pink_pdf.py",
    "pdf:server": "python tools/pink_server.py",
    "pink:prepare": "node scripts/prepare-pink.mjs --compile",
    "dev": "node scripts/background.mjs && vite --host 127.0.0.1",
    "build": "node scripts/background.mjs && tsc -b && vite build",
    "test": "vitest run",
    "test:glass": "node scripts/glass-test.cjs",
    "test:performance": "node scripts/performance-test.cjs http://127.0.0.1:4173/",
    "test:library": "node scripts/library-test.cjs",
    "test:browser": "node scripts/browser-test.cjs",
    "test:edges": "node scripts/edge-test.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts vite.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
